# Хвилинного такту достатньо для звичайних раундів: дедлайни лежать у стані,
# тож раунд закривається першим тіком після дедлайну — похибка до хвилини.
#
# Для коротких тестових раундів (десятки секунд) постав OnUnitActiveSec=15s
# і AccuracySec=1s, а після тестів поверни назад.
#
# ⚠️ Відлік у підписі не може оновлюватись частіше, ніж спрацьовує таймер:
# підпис редагується лише під час тіка.

[Unit]
Description=Запуск votebot tick щохвилини

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
Unit=votebot.service

[Install]
WantedBy=timers.target
