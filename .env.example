# Токен бота з BotFather. Єдиний обов'язковий секрет.
BOT_TOKEN=

# Рівень логування: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Необов'язкові перевизначення шляхів (за замовчуванням — поруч із config.yaml)
# VOTEBOT_CONFIG=/path/to/votebot/config.yaml
# VOTEBOT_STATE=/path/to/votebot/state.json
# VOTEBOT_RUNTIME=/path/to/votebot/runtime
# VOTEBOT_MEDIA=/path/to/votebot/media
